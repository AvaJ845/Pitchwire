<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to AIConfig.plist (gitignored) and fill it in to point the app
  at the deployed backend. If AIConfig.plist is absent the app runs fully offline
  on deterministic fallbacks.

    BaseURL      https://pitchwire-ai.<your-subdomain>.workers.dev   (the Worker, NOT z.ai)
    ClientToken  the PITCHWIRE_CLIENT_TOKEN you set with `wrangler secret put`
                 (a rotatable scoped token — never a provider API key)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>BaseURL</key>
    <string></string>
    <key>ClientToken</key>
    <string></string>
</dict>
</plist>
