<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Pitchwire does not track users across apps or websites. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      No data is collected in the App Store sense: the app has no accounts,
      no analytics SDK, and no advertising. Story text is sent to Pitchwire's
      own backend only to produce the analysis/draft the user asked for; it is
      not linked to an identity and is not used for tracking. Revisit this
      array if that ever changes (e.g. stored user content, analytics).
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- LocalEntitlementStore + LLMLog store plan usage / a debug
                 capture toggle in UserDefaults, read back only by this app. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
